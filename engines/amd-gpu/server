#!/bin/bash -eu

port="$(modelctl get http.port)"
host="$(modelctl get http.host)"
sleep_idle_seconds="$(modelctl get sleep-idle-seconds)"
min_context_size="$(modelctl get min-context-size)"
model_name=$("$SNAP_NAME" model --format=json | jq -r '.name')

extra_args=()

verbose="$(modelctl get verbose)"
if [ "${verbose}" = "true" ]; then
  extra_args+=(--verbose)
fi

# Reasoning trace: llama.cpp changed the default between builds (b10344: off,
# b11100: on), so the flag is always passed explicitly instead of relying on the
# runtime default. The value comes from the snap configuration
# reasoning-preserve (default true); set it to false to save tokens.
if [ "$(modelctl get reasoning-preserve 2>/dev/null || echo true)" = "false" ]; then
  extra_args+=(--no-reasoning-preserve)
else
  extra_args+=(--reasoning-preserve)
fi

# DSpark speculative decoding: only the variant that ships the draft model
# declares DRAFT_FILE, so the flags follow that variable instead of a snap
# config. n-max is the block size the draft was trained with (7 tokens per
# forward pass).
if [ -n "${DRAFT_FILE:-}" ]; then
  extra_args+=(--model-draft "$DRAFT_FILE" --spec-type draft-dspark --spec-draft-n-max 7)
fi

set -x
# Identical to the cpu engine on purpose: llama.cpp defaults to --fit on and
# --gpu-layers auto, so it decides by itself how many layers to place in VRAM.
# No --threads: the default (physical cores) is the fastest.
# See engines/cpu/server for the --jinja and --min-p rationale.
exec llama-server \
  --model "$MODEL_FILE" \
  --alias "$model_name" \
  --port "$port" \
  --host "$host" \
  --no-warmup \
  --sleep-idle-seconds "$sleep_idle_seconds" \
  --fit-ctx "$min_context_size" \
  --jinja \
  --min-p 0.0 \
  "${extra_args[@]}" \
  "$@"
