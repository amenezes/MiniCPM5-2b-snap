#!/bin/bash -eu

tag="snap.$SNAP_INSTANCE_NAME.hook.install"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag=$tag))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag=$tag)

#
# Set generic config
#

modelctl set --package http.port="8354"
modelctl set --package http.host="127.0.0.1"
modelctl set --package verbose="false"

# Webui server config
modelctl set --package webui.http.port="8355"
modelctl set --package webui.http.host="127.0.0.1"

#
# WSL workaround
#
# With a layout we bind $SNAP_COMMON/usr/lib/wsl to /usr/lib/wsl.
# The layout automatically creates the source directory if it does not exist.
# We then create symlinks in this dir for the lib and drivers subdirectories,
# so they appear at /usr/lib/wsl/lib and /usr/lib/wsl/drivers in the layout.
#
# -sfn instead of -s: `snap remove` without --purge keeps $SNAP_COMMON, so on a
# reinstall the links already exist and, under `set -e`, plain `ln -s` would
# abort the hook before the engine selection below.
ln -sfn /var/lib/snapd/hostfs/usr/lib/wsl/lib $SNAP_COMMON/usr/lib/wsl/lib
ln -sfn /var/lib/snapd/hostfs/usr/lib/wsl/drivers $SNAP_COMMON/usr/lib/wsl/drivers

#
# Auto select an engine
#

modelctl use-engine --auto --components --assume-yes --fallback=cpu
